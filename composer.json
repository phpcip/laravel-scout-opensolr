{
    "name": "opensolr/laravel-scout-opensolr",
    "description": "Laravel Scout driver for Opensolr — managed Apache Solr with server-side embeddings and hybrid BM25+kNN search",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "scout", "opensolr", "solr", "search", "hybrid-search", "vector", "full-text"],
    "homepage": "https://opensolr.com/langchain",
    "authors": [
        { "name": "Opensolr", "email": "support@opensolr.com" }
    ],
    "require": {
        "php": "^8.1",
        "laravel/scout": "^10.0 || ^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Opensolr\\ScoutOpensolr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opensolr\\ScoutOpensolr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Opensolr\\ScoutOpensolr\\OpensolrScoutServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
